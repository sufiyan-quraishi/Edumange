<%@ page contentType="text/html;charset=UTF-8" language="java" %>

<!-- ================= UNIVERSAL ADMIN FOOTER ================= -->
<footer style="margin-top: 40px; padding: 22px 20px 14px 20px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
    
    <!-- 1. LEFT: Original EduManage Logo & Brand -->
    <div style="display: flex; align-items: center; gap: 10px; margin-left: 35px;">
        <i class="fas fa-graduation-cap" style="font-size: 28px; color: var(--primary, #4f6ef7);"></i>
        <div>
            <strong style="font-size: 16px; color: var(--text); display: block; line-height: 1.2;">EduManage</strong>
            <small style="color: var(--text-muted); font-size: 12px;">Empowering Education, Together.</small>
        </div>
    </div>

    <!-- 2. CENTER: Support Info & Copyright -->
    <div style="text-align: center; color: var(--text-muted); font-size: 12.5px;">
        <div style="display: flex; gap: 18px; margin-bottom: 5px; justify-content: center; flex-wrap: wrap;">
            <span style="display: inline-flex; align-items: center; gap: 6px;">
                <i class="fas fa-envelope" style="color: var(--primary, #4f6ef7);"></i> edumanagesupport@gmail.com
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px;">
                <i class="fas fa-globe" style="color: var(--primary, #4f6ef7);"></i> www.edumanage.com
            </span>
        </div>
        <div>&copy; 2026 EduManage. All rights reserved.</div>
    </div>

    <!-- 3. RIGHT: Social Media Icons -->
    <div style="display: flex; align-items: center; gap: 10px; margin-right: 110px;">
        <span style="font-size: 13px; color: var(--text-muted); font-weight: 600;">Follow us &gt;</span>
        <a href="#" title="Facebook" style="width: 32px; height: 32px; border-radius: 50%; background: #1877f2; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 14px; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
            <i class="fab fa-facebook-f"></i>
        </a>
        <a href="#" title="LinkedIn" style="width: 32px; height: 32px; border-radius: 50%; background: #0077b5; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 14px; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
            <i class="fab fa-linkedin-in"></i>
        </a>
        <a href="#" title="Instagram" style="width: 32px; height: 32px; border-radius: 50%; background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 14px; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
            <i class="fab fa-instagram"></i>
        </a>
    </div>

</footer>